# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=hrm
POSTGRES_PASSWORD=change_me_in_local_dev
POSTGRES_DB=hrm
POSTGRES_PORT=5432

# Used by the backend (and by Prisma CLI on the host).
# Inside docker compose the host is `postgres`; from your machine it is `localhost`.
DATABASE_URL=postgresql://hrm:change_me_in_local_dev@localhost:5432/hrm?schema=public

# --- Backend ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Company / attendance policy -------------------------------------------
WORK_START=08:00
WORK_END=17:30
LATE_GRACE_MINUTES=5
ANNUAL_LEAVE_DAYS=12

# --- AI ---------------------------------------------------------------------
# openai | anthropic | fake
# `fake` needs no API key and returns scripted answers — use it to run the app
# and the test suite without spending money.
AI_PROVIDER=fake
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# Any OpenAI-compatible gateway works: OpenAI, Groq, OpenRouter, Together, Ollama.
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=30000
AI_MAX_TOOL_ITERATIONS=5
AI_RATE_LIMIT_PER_HOUR=30

# --- Frontend (build-time, must be prefixed with VITE_) ---------------------
VITE_API_URL=http://localhost:4000/api/v1
